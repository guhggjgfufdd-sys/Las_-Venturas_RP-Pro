<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B131E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أخبار Las Venturas RP"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="كل ما يخص المدينة في مكان واحد"
            android:textColor="#9BA9B8"
            android:textSize="14sp"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/news_card"
            android:text="إطلاق اللانشر الرسمي

تم تجهيز نسخة Las Venturas RP لتعمل على ARM32 وARM64 مع دعم المايك، المودات والواجهات الحديثة."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="right"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/news_card"
            android:text="تحديث المدينة

تابع الإعلانات والفعاليات داخل السيرفر، والتزم بالقوانين قبل دخولك إلى اللعبة."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="right"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/news_card"
            android:text="الدعم والمجتمع

للحصول على المساعدة أو متابعة الأخبار، استخدم روابط المجتمع الموجودة في الصفحة الرئيسية."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="right"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
